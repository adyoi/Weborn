[Unit]
Description=Weborn app
After=network.target

[Service]
User=weborn-tesapp
Group=weborn-tesapp
WorkingDirectory=/var/www/tesapp
EnvironmentFile=/var/www/tesapp/.env
ExecStart=/bin/bash -c '"'"'cd /var/www/tesapp && uvicorn main:app --host 0.0.0.0 --port 8000'"'"'
Restart=on-failure

[Install]
WantedBy=multi-user.target
