{
  "id": "apache",
  "name": "Apache",
  "description": "Web server klasik (cocok untuk Laravel/PHP legacy)",
  "category": "web-server",
  "type": "system",
  "packages": ["apache2"],
  "systemd_unit": "apache2",
  "bin": "apache2",
  "ports": [80, 443],
  "icon": "🗿",
  "config": {
    "path": "/etc/apache2/apache2.conf",
    "template": "apache2.conf.j2"
  },
  "fields": [
    {"name": "server_tokens", "label": "Server Tokens", "default": "Prod"},
    {"name": "keepalive", "label": "KeepAlive", "default": "On"}
  ]
}
