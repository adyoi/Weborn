; PHP-FPM pool config — Generated by Weborn
; App: {{ name }} | Domain: {{ domain }}

[{{ name }}]
user = {{ user | default('www-data') }}
group = {{ user | default('www-data') }}

listen = /run/php/php{{ php_version | default('8.2') }}-fpm-{{ name }}.sock
listen.owner = {{ user | default('www-data') }}
listen.group = www-data
listen.mode = 0660

; ── Process management ──
pm = dynamic
pm.max_children = {{ pm_max_children | default(5) }}
pm.start_servers = {{ pm_start_servers | default(2) }}
pm.min_spare_servers = {{ pm_min_spare_servers | default(1) }}
pm.max_spare_servers = {{ pm_max_spare_servers | default(3) }}
pm.max_requests = 500

; ── Logging ──
php_admin_flag[log_errors] = on
php_admin_value[error_log] = /var/log/php-fpm/{{ name }}_error.log

; ── Environment ──
env[APP_ENV] = production
env[APP_DEBUG] = 0

; ── Security ──
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen
php_admin_value[expose_php] = off

; ── Upload limits ──
php_admin_value[upload_max_filesize] = 64M
php_admin_value[post_max_size] = 64M
php_admin_value[max_execution_time] = 120
php_admin_value[memory_limit] = 256M
