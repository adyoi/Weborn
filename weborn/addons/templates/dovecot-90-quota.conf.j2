# Dovecot 90-quota.conf — Generated by Weborn (Dovecot 2.4 syntax)
# Kuota per mailbox: limit override per-user dari extra field userdb passwd-file
# `userdb_quota_storage_size` di /etc/dovecot/passwd. Postfix menolak penerima
# saat mailbox penuh via service quota-status (check_policy_service).

# Default bila user tidak menetapkan kuota sendiri (1G, tanpa suffix = byte).
quota_storage_size = 1G

quota "User quota" {
}

# Custom pesan saat klien IMAP/SMTP melebihi kuota.
quota_exceeded_message = "Mailbox penuh - kosongkan sebagian surat dulu."

service quota-status {
  executable = quota-status -p postfix
  unix_listener /var/spool/postfix/private/quota-status {
    mode = 0660
    user = postfix
    group = postfix
  }
  client_limit = 1
}

quota_status_nouser = DUNNO
quota_status_success = DUNNO
quota_status_overquota = 552 5.2.2 Mailbox penuh