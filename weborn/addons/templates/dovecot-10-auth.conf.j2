# Dovecot 10-auth.conf — Generated by Weborn
# Auth: virtual mailboxes. Semua mailbox adalah virtual user milik satu owner OS
# ({{ mail_owner }}). Password per-email di-passwd-file (/etc/dovecot/passwd),
# userdb static → uid/gid + home = /var/mail/vhosts/%{user}.

auth_mechanisms = plain login
auth_verbose = yes

# Username = alamat email penuh (user@domain). JANGAN set auth_username_format
# supaya `admin@{{ domain }}` tetap utuh dan cocok dengan passwd-file.

# ─── Passdb + Userdb: passwd-file (per-email) ───
# Semua mailbox virtual milik owner {{ mail_owner }} (uid/gid {{ vuid }}:{{ vgid }}).
# File: /etc/dovecot/passwd — baris: email:{hash}:{uid}:{gid}::{home}:/usr/sbin/nologin[:quota=<size>]
passdb passwd-file {
  passwd_file_path = /etc/dovecot/passwd
}

userdb passwd-file {
  passwd_file_path = /etc/dovecot/passwd
}

service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
}
