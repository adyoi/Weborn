# Nginx site config — Generated by Weborn
# App: {{ name }} | Type: {{ app_type }} | Domain: {{ domain }}

# ─── Gunicorn upstream (WSGI/ASGI apps) ───
{% if sock %}
upstream {{ name }}_backend {
    server unix:{{ sock }} fail_timeout=0;
}
{% endif %}

server {
    listen 80;
    server_name {{ domain }}{% if subdomain %} {{ subdomain }}.{{ domain }}{% endif %};

    {% if ssl %}
    listen 443 ssl http2;
    ssl_certificate     /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    {% endif %}

    root {{ document_root }};
    index index.php index.html index.htm;

    # ── Logging ──
    access_log /var/log/nginx/{{ name }}_access.log;
    error_log  /var/log/nginx/{{ name }}_error.log;

    # ── Security headers ──
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    {% if app_type in ['static'] %}
    # ── Static site: serve directly ──
    location / {
        try_files $uri $uri/ =404;
    }
    {% elif app_type in ['laravel', 'php'] %}
    # ── PHP: via PHP-FPM ──
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    location ~ \.php$ {
        fastcgi_pass unix:{{ php_fpm_sock | default('/run/php/php8.2-fpm.sock') }};
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
    {% elif app_type in ['nodejs'] %}
    # ── Node.js: reverse proxy ──
    location / {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    {% elif sock %}
    # ── Python (WSGI/ASGI): via Gunicorn socket ──
    location / {
        proxy_pass http://{{ name }}_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;

        # WebSocket support (ASGI)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    {% endif %}

    # ── Static files cache ──
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # ── Deny dotfiles ──
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}

{% if not ssl %}
