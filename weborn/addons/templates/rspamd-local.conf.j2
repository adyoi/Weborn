# Rspamd local.conf — Generated by Weborn
# Anti-spam & anti-virus for mail server

# ─── Logging ───
log_level = "info";

# ─── Lua paths ───
lua_path = "${PLUGINSDIR}/?.lua";

# ─── Milter protocol ───
milter {
  default_ip = "127.0.0.1";
  default_port = 11332;
  protocol = "Milter";
  timeout = 60s;
}

# ─── Proxy milter ───
proxy {
  milter {
    default_ip = "127.0.0.1";
    default_port = 11332;
    protocol = "Milter";
  }
  bounce_key = "bounce";
}

# ─── Antivirus (ClamAV integration) ───
antivirus {
  clamav {
    servers = "127.0.0.1:3310";
    scheme = "clamav";
    scan_mime_parts = true;
    scan_text_map = "*";
  }
}

# ─── Greylisting (disabled by default, recommended to enable later) ───
greylisting {
  enabled = false;
}

# ─── DKIM signing ───
dkim_signing {
  domain {
    {{ domain }} {
      selector = "weborn";
      path = "/var/lib/rspamd/dkim/{{ domain }}.weborn.key";
    }
  }
  sign_local = true;
  sign_authenticated = true;
}

# ─── SPF ───
spf {
  enabled = true;
}

# ─── DMARC ───
dmarc {
  enabled = true;
}

# ─── Reputation ───
reputation {
  enabled = true;
}
