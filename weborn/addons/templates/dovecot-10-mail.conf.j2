# Dovecot 10-mail.conf — Generated by Weborn
# Mail format: Maildir. home diambil dari passwd-file
# (/var/mail/vhosts/<email>) → Maildir = /var/mail/vhosts/<email>/Maildir.

namespace inbox {
  inbox = yes
  separator = .
  prefix =
  mail_driver = maildir
  mail_path = ~/Maildir
  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }
  mailbox Junk {
    special_use = \Junk
    auto = subscribe
  }
  mailbox Sent {
    special_use = \Sent
    auto = subscribe
  }
  mailbox Trash {
    special_use = \Trash
    auto = subscribe
    autoexpunge = 30d
  }
  mailbox Archive {
    special_use = \Archive
    auto = subscribe
  }
}

mail_privileged_group = mail
first_valid_uid = 0
last_valid_uid = 0

# ─── Plugin Quota ───
# Limit per-user dari extra field userdb passwd-file: `userdb_quota_storage_size`.
mail_plugins {
  quota = yes
}

protocol imap {
  imap_client_workarounds = delay-newmail
  mail_max_userip_connections = 20
  # IMAP QUOTA extension (klien bisa lihat pemakaian kuota)
  mail_plugins {
    imap_quota = yes
  }
}
protocol lda {
   # Sieve (filter/vacation) + quota pada delivery via dovecot-lda
   mail_plugins {
     sieve = yes
     quota = yes
   }
 }
protocol pop3 {
  pop3_uidl_format = %{uid|hex(8)}%{uidvalidity|hex(8)}
  pop3_client_workarounds {
    outlook-no-nuls = yes
  }
}

# ─── Penyimpanan script Sieve per-user ───
# Personal storage digunakan saat deliver (vacation aktif) dan oleh klien.
sieve_script personal {
  path = ~/.dovecot.sieve
}
