# Gunicorn config — Generated by Weborn
# App: {{ name }} | Type: {{ app_type }} | Workers: {{ workers }}

import multiprocessing
import os

# ── Server socket ──
bind = "unix:{{ sock }}"
backlog = 2048

# ── Worker processes ──
{% if app_type in ['asgi', 'fastapi'] %}
# ASGI workers: uvicorn for async I/O
worker_class = "uvicorn.workers.UvicornWorker"
{% else %}
# WSGI workers: sync (default)
worker_class = "sync"
{% endif %}
workers = {{ workers | default(4) }}
threads = 2
worker_tmp_dir = "/dev/shm"

# ── Timeouts ──
timeout = 120
graceful_timeout = 30
keepalive = 5

# ── Logging ──
accesslog = "/var/log/gunicorn/{{ name }}_access.log"
errorlog = "/var/log/gunicorn/{{ name }}_error.log"
loglevel = "info"
access_log_format = '%(h)s %(l)s %(u)s %(t)s "%(r)s" %(s)s %(b)s "%(f)s" "%(a)s" %(D)s'

# ── Process naming ──
proc_name = "{{ name }}"

# ── Server hooks ──
def on_starting(server):
    """Create log dir if not exists."""
    log_dir = "/var/log/gunicorn"
    os.makedirs(log_dir, exist_ok=True)

def post_fork(server, worker):
    """Reset signals after fork."""
    import signal
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
